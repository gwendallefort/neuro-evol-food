    <style>
        :root {
            --bg: #d8e0da;
            --bg-deep: #c2cdc6;
            --ink: #1a2420;
            --muted: #5a6a61;
            --accent: #2f6b4f;
            --line: rgba(26, 36, 32, 0.12);
            --font: "Sora", "Segoe UI", sans-serif;
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            width: 100%;
            height: 100%;
            overflow: hidden;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: var(--font);
            color: var(--ink);
            background:
                radial-gradient(120% 80% at 12% 8%, #eef3ef 0%, transparent 55%),
                radial-gradient(90% 70% at 88% 92%, #c9d5cd 0%, transparent 50%),
                linear-gradient(160deg, var(--bg), var(--bg-deep));
            -webkit-font-smoothing: antialiased;
        }

        #transfer {
            position: fixed;
            inset: 0;
            z-index: 20;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 1rem;
            padding: 2rem;
            background: inherit;
            animation: fade-in 0.45s ease-out both;
        }

        /* Author display:flex must not override the HTML [hidden] attribute. */
        #transfer[hidden] {
            display: none !important;
        }

        #transfer::before {
            content: "";
            width: 2.25rem;
            height: 2.25rem;
            border: 2.5px solid var(--line);
            border-top-color: var(--accent);
            border-radius: 50%;
            animation: spin 0.7s linear infinite;
        }

        #status {
            margin: 0;
            padding: 0;
            border: none;
            background: transparent;
            box-shadow: none;
            font-family: var(--font);
            font-size: 0.85rem;
            font-weight: 400;
            letter-spacing: 0.02em;
            color: var(--muted);
            text-align: center;
        }

        #progress {
            appearance: none;
            -webkit-appearance: none;
            width: min(18rem, 70vw);
            height: 0.2rem;
            border: none;
            background: var(--line);
            overflow: hidden;
        }

        #progress::-webkit-progress-bar {
            background: var(--line);
        }

        #progress::-webkit-progress-value {
            background: var(--accent);
            transition: width 0.2s ease;
        }

        #progress::-moz-progress-bar {
            background: var(--accent);
        }

        div.emscripten { text-align: center; }
        div.emscripten_border { border: 1px solid var(--line); }

        /* the canvas *must not* have any border or padding, or mouse coords will be wrong */
        canvas.emscripten {
            border: 0 none;
            background-color: transparent;
            width: 100%;
            height: 100%;
            z-index: 5;
            padding: 0;
            margin: 0 auto;
            position: absolute;
            top: 0;
            bottom: 0;
            left: 0;
            right: 0;
            animation: fade-in 0.55s ease-out both;
        }

        .bottomright {
            position: absolute;
            top: 40%;
            right: 0;
        }

        .trinfo {
            position: relative;
            right: 0;
            border: 1px solid var(--line);
        }

        .framed {
            position: relative;
            top: 150px;
            right: 10px;
            border: 1px solid var(--line);
        }

        #pyconsole {
            font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
        }

        @keyframes fade-in {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        @media (prefers-reduced-motion: reduce) {
            #transfer,
            canvas.emscripten {
                animation: none;
            }

            #transfer::before {
                animation: none;
                border-color: var(--accent);
            }
        }
    </style>

