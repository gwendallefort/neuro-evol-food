import asyncio
import platform
from pathlib import Path

PUBLIC_CDN = "https://pygame-web.github.io/cdn/"


# do not rename
async def custom_site():
    import embed
    platform.document.body.style.background = "#d8e0da"

    # On any localhost URL, pygbag defaults package installs to
    # http://localhost:<port>/cdn/ (its own test-server proxy). When the build
    # is embedded in another local site (e.g. Laravel on :8000), that proxy
    # does not exist and numpy/pygame wheels 404. Prefer the public CDN.
    PyConfig.pkg_indexes = [PUBLIC_CDN]

    # Keep #transfer visible until main.py calls configure_web_display().
    platform.window.canvas.style.visibility = "visible"

    def set_status(msg):
        # Do NOT use platform.window.status — that is the browser's legacy
        # window.status string, not #status. Writing .innerText on it deadlocks
        # the pygbag/wasm runtime (loader freezes after the package index fetch).
        try:
            el = platform.document.getElementById("status")
            if el is not None:
                el.innerHTML = msg
        except Exception:
            pass

    def dismiss_loading_shell():
        platform.window.transfer.hidden = True
        platform.window.transfer.style.display = "none"
        platform.window.config.gui_divider = 1
        platform.window.window_resize()

    bundle = "{{cookiecutter.archive}}"
    appdir = Path(f"/data/data/{bundle}")
    appdir.mkdir()

    set_status("Unpacking...")
    if platform.window.location.host.find('.itch.zone') > 0:
        import zipfile
        async with platform.fopen("{{cookiecutter.archive}}.apk", "rb") as archive:
            with zipfile.ZipFile(archive) as zip_ref:
                zip_ref.extractall(appdir.as_posix())
    else:
        import tarfile
        async with platform.fopen("{{cookiecutter.archive}}.tar.gz", "rb") as archive:
            tar = tarfile.open(fileobj=archive, mode="r:gz")
            tar.extractall(path=appdir.as_posix(), filter='tar')
            tar.close()

    set_status("Preparing runtime...")
    platform.run_main(PyConfig, loaderhome=appdir / "assets", loadermain=None)

    while embed.counter() < 0:
        await asyncio.sleep(.1)

    main = appdir / "assets" / "main.py"

    if not platform.window.MM.UME:
        __import__(__name__).__file__ = main
        msg = "Click or tap to start"
        set_status(msg)
        print("\n" * 4, f"    * Waiting for media user engagement. {msg} *", "\n" * 4)
        while not platform.window.MM.UME:
            await asyncio.sleep(.1)

    set_status("Starting...")
    await TopLevel_async_handler.start_toplevel(platform.shell, console=window.python.config.debug)

    __import__(__name__).__file__ = main

    # Re-assert after toplevel start in case startup reset indexes.
    # Also rewrite any already-loaded repo CDN bases (localhost /cdn proxy).
    PyConfig.pkg_indexes = [PUBLIC_CDN]
    try:
        import aio.pep0723
        for repo in getattr(aio.pep0723.Config, "pkg_repolist", []) or []:
            if isinstance(repo, dict) and "-CDN-" in repo:
                repo["-CDN-"] = PUBLIC_CDN
    except Exception as e:
        print("custom.tmpl: could not rewrite pkg CDN:", e)

    def ui_callback(pkg):
        set_status(f"Installing {pkg}")

    set_status("Loading simulation...")
    await shell.source(main, callback=ui_callback)

    # Reached only if main.py returns (async game loops usually do not).
    # Loading UI dismissal is normally handled by configure_web_display().
    dismiss_loading_shell()
    print("custom.tmpl: done")
    shell.interactive()

asyncio.run(custom_site())




